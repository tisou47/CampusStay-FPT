# Store text with LF in the repository and check it out with LF on every OS
# (Flyway migrations, shell scripts and Docker files must not change on Windows).
* text=auto eol=lf

*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.docx binary
*.xlsx binary
*.xls  binary
*.jar  binary
