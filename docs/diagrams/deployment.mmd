%% Environments and delivery: local development, Vercel previews, production (also the demo environment)
flowchart TB
  dev["Developer machine (dev)<br/>backend: mvn spring-boot:run (profile dev) + PostgreSQL 18<br/>web: npm run dev (Vite proxy /api)<br/>Android: Android Studio, emulator or phone"]
  gh["GitHub repository<br/>tisou47/CampusStay-FPT (monorepo)"]
  subgraph CI["GitHub Actions — backend.yml (push to main touching backend/**)"]
    v["verify: mvn verify<br/>(unit + integration tests, Testcontainers PostgreSQL 17)"]
    i["image: Docker build → GHCR<br/>ghcr.io/tisou47/campusstay-backend:&lt;sha&gt;"]
    d["deploy: SSH to the VM,<br/>docker compose pull + up -d api,<br/>readiness check /api/actuator/health"]
    v --> i --> d
  end
  subgraph VER["Vercel"]
    pv["Preview deployments<br/>(other branches, when web/ changed)"]
    pr["Production web<br/>campusstay-fpt-ten.vercel.app"]
  end
  subgraph PROD["Production / demo environment (Azure for Students, East Asia)"]
    vm["VM campusstay-vm (Docker Compose, /opt/campusstay)<br/>Caddy + API container + file volume<br/>campusstay-api.eastasia.cloudapp.azure.com"]
    pg[("Azure Database for PostgreSQL<br/>(managed)")]
    vm --> pg
  end
  dev -- "git push (feature branch)" --> gh
  gh -- "fast-forward main" --> CI
  gh -- "every push" --> VER
  d --> vm
  i -. "rollback: API_TAG=&lt;older sha&gt;" .-> vm
