%% Detailed design: assignment runs and residence (ASG)
classDiagram
  direction LR
  class AssignmentController {
    +runs() / start(termId, dryRun)
    +proposal(runId) / conflict(runId, app)
    +resolve(runId, app, key)
    +commit(runId) / approve(runId) / return(runId)
  }
  class AssignmentService {
    +start(term, dryRun)
    +resolve(run, application, resolution)
    +submit(run, block)
    +approve(run, block)
    +returnToStaff(run, block, comment)
  }
  class EngineFactory {
    +engine(term, settings) AssignmentEngine
    +applicants(term)
  }
  class AssignmentEngine {
    +run(applications, beds) proposal
    +match(group)
    +placeSingle(application)
    +freeBeds()
  }
  class MatchingCriteria {
    <<interface CFG>>
    +forTerm(termId) snapshot
  }
  class Inventory {
    <<interface INV>>
    +assignableBeds(termId)
  }
  class OpenRenewalRequests {
    <<interface>>
    +total(termId)
  }
  class Round2Offers {
    +offer(termId, applications)
  }
  class Billing {
    <<interface BIL>>
    +issueBalance(allocation)
  }
  class DoorCodeRelease {
    +releaseDue()
  }
  class ForfeitService {
    +forfeitDue()
  }
  class DeskService {
    +checkIn(student)
    +checkOut(allocation, readings, damages)
  }
  AssignmentController --> AssignmentService
  AssignmentService --> EngineFactory
  EngineFactory --> AssignmentEngine
  AssignmentService --> MatchingCriteria
  AssignmentService --> Inventory
  AssignmentService --> OpenRenewalRequests : no open next-Term request
  AssignmentService --> Billing : Balance Invoices
  AssignmentService --> Round2Offers : Waitlisted
  DoorCodeRelease ..> Billing : paid?
  ForfeitService ..> Billing : balancesPastDue
  DeskService --> Billing : settleCheckOut
