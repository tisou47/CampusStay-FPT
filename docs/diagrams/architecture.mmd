%% System overview: components, external services and the main data flows
flowchart TB
  web["Web app — React 19, Vite 8, Tailwind 4<br/>student portal and back office (Staff, Manager, Admin)"]
  android["Android app — Kotlin, Jetpack Compose<br/>students"]
  vercel["Vercel<br/>static web build, CDN, HTTPS"]
  subgraph VM["Azure VM — Docker Compose"]
    caddy["Caddy<br/>reverse proxy, HTTPS (Let's Encrypt)"]
    api["CampusStay API — Spring Boot 4.1, Java 21<br/>controller → service → repository<br/>AUTH CFG INV APP ASG BIL REQ MNT NTF RPT<br/>scheduled jobs, events, email outbox, push"]
    files[("File volume<br/>photos, receipts, evidence")]
  end
  db[("Azure Database for PostgreSQL 17<br/>98 tables, 32 report views<br/>Flyway migrations V1–V59")]
  google["Google Identity Services<br/>sign-in, ID token"]
  fcm["Firebase Cloud Messaging<br/>push to Android"]
  smtp["Gmail SMTP<br/>email"]
  qr["VietQR image service<br/>qr.sepay.vn"]
  bank["Bank account<br/>students transfer, no API"]

  vercel -. "serves the web app" .-> web
  web -- "HTTPS JSON /api, Bearer token" --> caddy
  android -- "HTTPS JSON /api, Bearer token" --> caddy
  caddy --> api
  api --- files
  api -- "JDBC over TLS" --> db
  api -- "verify ID token" --> google
  api -- "FCM HTTP v1" --> fcm
  api -- "SMTP over TLS" --> smtp
  web -- "sign-in popup" --> google
  android -- "Credential Manager" --> google
  fcm -. "push" .-> android
  web -- "QR image URL" --> qr
  android -- "QR image URL" --> qr
  web -. "transfer with content CSTAY…" .-> bank
