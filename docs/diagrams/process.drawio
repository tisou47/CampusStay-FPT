<mxfile host="CampusStay FPT (docs/tools/drawio.mjs)" type="device"><diagram id="Development process: two-week sprints, one branch per change, checks before main, automatic deployment" name="Development process: two-week sprints, one branch per change, checks before main, automatic deployment"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n-backlog" value="Product backlog&lt;br&gt;(Brief, Change Spec v2,&lt;br&gt;mentor and review feedback)" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="263" y="20" width="181" height="62" as="geometry"/></mxCell><mxCell id="n-plan" value="Sprint planning&lt;br&gt;(every 2 weeks, offline)" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="185" y="137" width="150" height="46" as="geometry"/></mxCell><mxCell id="n-sprint" value="Sprint backlog&lt;br&gt;owner per item" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="207" y="238" width="106" height="46" as="geometry"/></mxCell><mxCell id="n-branch" value="Branch per change&lt;br&gt;feat/… fix/… docs/…" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="339" width="137" height="46" as="geometry"/></mxCell><mxCell id="n-code" value="Design, code and tests&lt;br&gt;(Claude Code assisted)" style="rounded=0;html=1;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="176" y="440" width="152" height="46" as="geometry"/