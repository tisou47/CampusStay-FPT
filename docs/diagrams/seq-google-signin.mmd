%% Sequence: sign in with Google (new student accounts are created on the first sign-in)
sequenceDiagram
  autonumber
  actor U as Student
  participant W as Web or Android app
  participant G as Google Identity
  participant C as AuthController
  participant S as SignInService
  participant V as GoogleIdTokenVerifier
  participant N as StudentSignUp
  participant SS as SessionService
  participant DB as PostgreSQL
  U->>W: "Sign in with Google"
  W->>G: Google sign-in (popup / Credential Manager)
  G-->>W: ID token
  W->>C: POST /auth/google {credential}
  C->>S: signInWithGoogle(idToken)
  S->>V: verify(idToken)
  V-->>S: email, subject, hosted domain
  alt account exists
    S->>DB: find auth_user by email / google_sub
  else new @fpt.edu.vn student
    S->>N: signUp(identity)
    N->>DB: insert auth_user (no password) + auth_student (Pending verification)
  end
  S->>SS: create(user, GOOGLE, remember)
  SS->>DB: insert auth_session (hashed token)
  S-->>C: token, user, passwordSet, verification
  C-->>W: 200 session
  W-->>U: home, or "set a password" / verification form first (AccountSetupGate)
