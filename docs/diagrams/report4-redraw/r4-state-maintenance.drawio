<mxfile host="app.diagrams.net"><diagram id="r4-state-maintenance" name="Maintenance Request state machine (mnt_request.status)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="Maintenance Request state machine (mnt_request.status)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=386;height=24;fontStyle=2;fontSize=12;align=left;spacingLeft=8;pointerEvents=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1250" height="540" as="geometry"/></mxCell><mxCell id="s0" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="318" y="38" width="24" height="24" as="geometry"/></mxCell><mxCell id="SUB" value="Submitted" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="255" y="138" width="150" height="44" as="geometry"/></mxCell><mxCell id="ASG" value="Assigned" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="625" y="138" width="150" height="44" as="geometry"/></mxCell><mxCell id="INP" value="In progress" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="995" y="138" width="150" height="44" as="geometry"/></mxCell><mxCell id="RES" value="Resolved" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="995" y="368" width="150" height="44" as="geometry"/></mxCell><mxCell id="CLO" value="Closed" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fi