<mxfile host="app.diagrams.net"><diagram id="r4-state-invoice" name="Invoice state machine (bil_invoice.status)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="frame" value="Invoice state machine (bil_invoice.status)" style="shape=umlFrame;whiteSpace=wrap;html=1;width=307;height=24;fontStyle=2;fontSize=12;align=left;spacingLeft=8;pointerEvents=0;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="10" y="0" width="1270" height="600" as="geometry"/></mxCell><mxCell id="s0" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="288" y="38" width="24" height="24" as="geometry"/></mxCell><mxCell id="UN" value="Unpaid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="148" width="150" height="44" as="geometry"/></mxCell><mxCell id="AC" value="Awaiting confirmation" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="615" y="148" width="170" height="44" as="geometry"/></mxCell><mxCell id="PD" value="Paid" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1025" y="148" width="150" height="44" as="geometry"/></mxCell><mxCell id="OV" value="Overdue" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="225" y="408" width="150" height="44" as="geometry"/></mxCell><mxCell id="VO" value="Void" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;fontStyle=1;arcSize=24;fillColor=#fff2cc;strokeColor=#d6b