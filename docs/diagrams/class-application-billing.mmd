%% Detailed design: Applications, Invoices and payment claims (APP, BIL)
classDiagram
  direction LR
  class ApplicationController {
    +eligibility()
    +roommateCheck()
    +create(ApplyRequest)
    +review(id) / bulkReview()
    +cancel(id)
  }
  class ApplicationService {
    +create(command)
    +checkRoommate(code)
    +respond(invitation, accept)
    +cancel(id, reason)
    +expireOverdue()
    ~on(PaymentConfirmed)
  }
  class EligibilityService {
    +check(student, term) checks
    +registrationTerm()
    +maxStayTerms()
  }
  class ApplicationReviewService {
    +queue() / detail(id)
    +review(id, decision) / bulkReview(ids)
    ~on(StudentNotEnrolled)
  }
  class Billing {
    <<interface>>
    +issueDeposit(application)
    +issueBalance(allocation)
    +issueTermFee(allocation)
    +isPaid(invoice)
    +requestRefund(...)
  }
  class JdbcBilling
  class StudentInvoiceController {
    +invoices() / invoice(id)
    +payment(id) VietQR
    +receipt(id) PDF
  }
  class PaymentClaimController {
    +claim(invoiceId, reference)
    +list()
    +confirm(ids) / reject(ids, reason)
  }
  class PaymentClaimService {
    +claim(invoice, reference)
    +confirm(ids) / confirmOne(id)
    +reject(ids, reason)
    +summarize(since)
  }
  class PaymentConfirmed {
    <<event>>
    invoiceId, type, applicationId, allocationId, paidAt
  }
  class ApplicationSubmitted {
    <<event>>
  }
  ApplicationController --> ApplicationService
  ApplicationController --> ApplicationReviewService
  ApplicationService --> EligibilityService
  ApplicationService --> Billing : Deposit Invoice
  Billing <|.. JdbcBilling
  PaymentClaimController --> PaymentClaimService
  PaymentClaimService ..> PaymentConfirmed : publishes
  PaymentConfirmed ..> ApplicationService : Deposit → Submitted
  ApplicationService ..> ApplicationSubmitted : publishes
  StudentInvoiceController --> JdbcBilling
