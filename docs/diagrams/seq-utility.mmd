%% Sequence: close a meter period and issue Utility Invoices; debt warnings
sequenceDiagram
  autonumber
  actor Sf as Staff
  participant MC as MeterController
  participant MS as MeterService
  participant RS as RoomStays (ASG)
  participant Sp as UtilitySplit
  participant B as Billing
  participant UD as UtilityDebtService
  participant OJ as OverdueJob (hourly)
  participant DB as PostgreSQL
  Sf->>MC: POST /meter-periods/{id}/import (CSV room,electricity,water)
  MC->>MS: importCsv(period, file)
  MS->>DB: every line checked first, then readings Entered / Check value
  Sf->>MC: POST /meter-periods/{id}/close
  MC->>MS: close(period)
  loop each Room with confirmed readings
    MS->>RS: stays(room, period start, end)
    MS->>DB: meter cuts of residents who left or moved
    MS->>Sp: split(points, residents, prices)
    Sp-->>MS: share per resident (by days lived, rounded)
    MS->>B: issue Utility Invoice per resident
    MS->>UD: afterIssued(student, invoice)
  end
  MS->>DB: period closed
  OJ->>UD: evaluateAll()
  UD->>DB: Overdue → warning 1, 2 overdue or debt ≥ Utility Deposit → final warning + date
  UD-->>UD: date reached → UtilityTerminationDue (termination notice)
