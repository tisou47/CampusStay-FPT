%% Detailed design: Maintenance Requests, routing, time limits and escalations (MNT, REQ)
classDiagram
  direction LR
  class MaintenanceController {
    +options() / report(form, photos)
    +list() / detail(id)
    +update(id, status, assignee) / addUpdate(id)
    +confirm(id, fixed)
  }
  class MaintenanceService {
    +options()
    +report(command)
    +studentView(id)
    +confirm(id, fixed, comment)
  }
  class MaintenanceDeskService {
    +queue(filters)
    +detail(id)
    +update(id, change)
    +addUpdate(id, message)
  }
  class MaintenanceReported {
    <<event>>
  }
  class MaintenanceRouting {
    <<listener REQ>>
    ~on(MaintenanceReported)
  }
  class RoutingService {
    +route(request) assignee
    +rules() / saveTimers()
    +sla(block)
  }
  class MaintenanceRequests {
    <<interface MNT port>>
    +assign(id, staff)
    +setSlaDue(id, at)
  }
  class EscalationJob {
    <<scheduled 15 min>>
  }
  class EscalationService {
    +scan()
    +list(filters)
    +act(id, action, note)
  }
  class Inventory {
    <<interface INV>>
    +furnitureOf(room)
  }
  class FurnitureRepairLogged {
    <<event>>
  }
  MaintenanceController --> MaintenanceService
  MaintenanceController --> MaintenanceDeskService
  MaintenanceService --> Inventory : furniture item of the Room
  MaintenanceService ..> MaintenanceReported : publishes
  MaintenanceReported ..> MaintenanceRouting
  MaintenanceRouting --> RoutingService
  MaintenanceRouting --> MaintenanceRequests
  EscalationJob --> EscalationService
  MaintenanceDeskService ..> FurnitureRepairLogged : resolved
