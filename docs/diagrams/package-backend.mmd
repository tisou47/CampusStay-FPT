%% Backend package diagram (vn.fpt.campusstay): layers, feature sub-packages and the allowed dependencies
flowchart TB
  controller["controller.{feature} — REST endpoints (54 classes)<br/>auth · setting · inventory · application · assignment · billing<br/>request · maintenance · notification · report · file"]
  service["service.{feature} — business rules, jobs, ports (242 classes)<br/>auth (AUTH) · setting (CFG) · inventory (INV) · application (APP)<br/>assignment (ASG) · billing (BIL) · request (REQ)<br/>maintenance (MNT) · notification (NTF) · report (RPT)"]
  repository["repository / entity — persistence<br/>JPA repositories and entities, JdbcClient stores per feature"]
  db[("PostgreSQL")]
  dto["dto<br/>shared records"]
  event["event<br/>domain events (53)"]
  security["security<br/>CurrentUser, Permission,<br/>BlockScope, SecurityConfig"]
  exception["exception<br/>ApiException, FieldErrors,<br/>LocalizedErrors"]
  common["common<br/>audit, files, export,<br/>search, i18n, demo"]
  config["config<br/>properties, clock, jobs, CORS"]
  controller --> service
  service --> repository
  repository --> db
  service -- "JdbcClient (owned tables only)" --> db
  controller --> dto
  controller --> security
  service --> dto
  service --> event
  service --> security
  service --> exception
  service --> common
  config ~~~ common
