%% Screen flow: public pages and the Student portal (web; the Android app has Home, My Room, Payments, Activity).
%% Grey boxes are menu groups; rounded shapes open from a link or a notification.
flowchart LR
  signin["SCR-AUTH-01 Sign In"] --> forgot["SCR-AUTH-02 Forgot password"] --> reset["SCR-AUTH-03 Reset password"]
  signin -- "first Google sign-in" --> setpw["SCR-AUTH-05 Set a password"] --> verify["SCR-AUTH-06 Account verification"] --> home
  signin --> home["SCR-HOME-01 Student Home<br/>(timeline, board, next step)"]
  home --> G1[Registration]:::grp
  home --> G2[Payments]:::grp
  home --> G3[My Room]:::grp
  home --> G4[Requests]:::grp
  G1 --> period["SCR-HOME-05 Registration period details"]
  G1 --> wiz["SCR-APP-01 Application Wizard<br/>1 Term and eligibility, 2 Room preference,<br/>Roommate (2-bed), 3 Personal info, 4 Review"] --> appd["SCR-APP-03 Application Detail"]
  G1 --> apps["SCR-APP-02 My Applications"] --> appd
  G1 --> inviteR(["SCR-APP-04 Roommate Invitation"])
  G1 --> r2(["SCR-ASG-02 Round 2 Offer"])
  G2 --> inv["SCR-BIL-01 My Invoices"] --> invd["SCR-BIL-03 Invoice detail"] --> pay["SCR-BIL-02 Invoice Payment<br/>(VietQR, I have transferred)"]
  appd --> pay
  G3 --> room["SCR-ASG-01 My Room<br/>(door code, check-in pass, furniture, Stay, next Term)"]
  G4 --> reqs["SCR-MNT-01 My Requests"]
  reqs --> mnew["SCR-MNT-02 New Maintenance Request"]
  reqs --> rcnew["SCR-REQ-02 Room change (next Term)"]
  reqs --> ccnew["SCR-REQ-08 Room Class change"]
  reqs --> swnew["SCR-REQ-03 Swap with a student"]
  reqs --> board["SCR-REQ-04 Swap Board"] --> swinv(["SCR-REQ-05 Swap Invitation"])
  classDef grp fill:#eeeeee,stroke:#999999
