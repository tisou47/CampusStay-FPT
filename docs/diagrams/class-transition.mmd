%% Detailed design: Term transition — requests window, next-Term requests, reconciliation and fees (ASG, REQ, AUTH)
classDiagram
  direction LR
  class RenewalJobs {
    <<scheduled 15 min>>
  }
  class RenewalService {
    +openDue() M2
    +closeDue() M3
    +escalateDue() M4 - 48 h
    +cancelUnpaidFees() M7
    +overview(term)
  }
  class Stays {
    <<interface>>
    +window(term) / filing(term)
    +extend(student, terms)
    +endAfterThisTerm(allocation)
    +continuingStudents(term)
  }
  class JdbcStays
  class Moves {
    <<interface>>
    +freeBeds(term, filter)
    +move(allocation, bed, reason)
  }
  class JdbcMoves
  class NextTermRequestsService {
    +open(filters) one list
    +decide(items, decision) bulk
  }
  class RoomChangeService {
    +create() / decide()
    +matchingBeds(id)
  }
  class SwapService {
    +direct() / respond() / decide()
    +board() / expire()
  }
  class StayRequestService {
    +extend() / endOfStay() / decide()
  }
  class RoomClassChangeService {
    +create() / consent() / decide() / setBack()
  }
  class ReconciliationService {
    +upload(term, kind, file)
    +resolve(item, outcome, note)
  }
  class NextTermFeeService {
    +preview(term) blockers
    +issue(term)
  }
  class StudentNotEnrolled {
    <<event>>
  }
  RenewalJobs --> RenewalService
  RenewalService --> Stays
  Stays <|.. JdbcStays
  Moves <|.. JdbcMoves
  NextTermRequestsService --> RoomChangeService
  NextTermRequestsService --> SwapService
  NextTermRequestsService --> StayRequestService
  NextTermRequestsService --> RoomClassChangeService
  RoomChangeService --> Moves
  SwapService --> Moves
  StayRequestService --> Stays
  ReconciliationService ..> StudentNotEnrolled : publishes
  StudentNotEnrolled ..> RenewalService : cancel next-Term Bed
  NextTermFeeService --> Stays
  NextTermFeeService ..> ReconciliationService : list reconciled?
