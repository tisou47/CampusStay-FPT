%% WF-01 Registration to residence: activity diagram (lanes = actors)
flowchart TD
  subgraph S1["Student"]
    a1(("start")) --> a2["Sign in (password or Google)"]
    a2 --> a3{"Eligible for the Term?"}
    a3 -- "no" --> a4["See the failed checks"] --> a5((("end")))
    a3 -- "yes" --> a6["Choose Room Type, Room Class,<br/>roommate, Gia hạn; accept rules"]
    a6 --> a7["Submit the Application"]
    a9["Transfer by VietQR and press<br/>'I have transferred'"]
    b9["Pay the Balance and claim it"]
  end
  subgraph SYS["System"]
    a8["Application: Awaiting Deposit<br/>Deposit Invoice due in 48 h"]
    x1{"Claim before the<br/>Deposit window ends?"}
    x2["Application: Expired"]
    b5["Allocations + Balance Invoices<br/>notify students (Assigned – unpaid)"]
    b6["Waitlisted: Round-2 offers"]
    b12{"Balance confirmed<br/>before its deadline?"}
    b13["Forfeit: Bed released,<br/>Deposit kept"]
    b14["Release the door code at the<br/>check-in start (Resident)"]
  end
  subgraph M["Manager"]
    m1{"Transfer found?"}
    m2["Reject the claim with a reason<br/>(time continues)"]
    m3["Confirm the claim:<br/>Application Submitted"]
    m4{"Review the Application"}
    m5["Reject with a reason"]
    m6["Run the assignment after M3,<br/>resolve conflicts, approve each Block"]
    m7["Confirm the Balance claim"]
  end
  a7 --> a8 --> a9 --> x1
  x1 -- "no" --> x2 --> a5
  x1 -- "yes" --> m1
  m1 -- "no" --> m2 --> a9
  m1 -- "yes" --> m3 --> m4
  m4 -- "reject" --> m5 --> a5
  m4 -- "approve" --> m6 --> b5
  m6 --> b6
  b5 --> b9 --> m7 --> b12
  b12 -- "no" --> b13 --> a5
  b12 -- "yes" --> b14 --> a5
