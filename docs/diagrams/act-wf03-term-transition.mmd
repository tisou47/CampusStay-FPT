%% WF-03 Term transition (renewal, next-Term requests, fees, turnover): activity diagram (lanes = actors)
flowchart TD
  subgraph SY["System"]
    s(("start M2")) --> y1["Open the requests window: every resident<br/>not leaving gets a next-Term Allocation<br/>(Continuing / Awaiting extension)"]
    y2["M3: close filing; not extended<br/>→ next-Term Bed released"]
    y5{"M7: next-Term fee paid?"}
    y6["Cancel the next-Term Allocation,<br/>Bed released (Round 2)"]
    y7["Continuing resident keeps the Bed"]
    e((("end")))
  end
  subgraph RS["Resident (Student)"]
    r1{"What for next Term?"}
    r2["Stay: nothing to file"]
    r3["File a room change, swap,<br/>Room Class change, extension<br/>or end of stay (before M3)"]
    r4["Pay the next-Term fee and claim it"]
  end
  subgraph SF["Staff"]
    f1["Decide the Block's requests by M4<br/>(one list, bulk decisions)"]
    f2["Turnover week: check out leavers<br/>(damage, Utility Deposit), move movers,<br/>new door codes"]
  end
  subgraph MG["Manager"]
    g1["Reconcile the enrolled list<br/>(resolve groups 1–2)"]
    g2{"Requests decided and<br/>list reconciled?"}
    g3["Issue next-Term fees (M6)"]
    g4["Confirm fee claims"]
  end
  y1 --> r1
  r1 -- "stay as is" --> r2 --> y2
  r1 -- "change" --> r3 --> y2
  y2 --> f1 --> g1 --> g2
  g2 -- "no: see the blockers" --> f1
  g2 -- "yes" --> g3 --> r4 --> g4 --> y5
  y5 -- "no" --> y6 --> f2
  y5 -- "yes" --> y7 --> f2
  f2 --> e
