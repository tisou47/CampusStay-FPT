%% WF-04 Maintenance Request with routing, time limit (SLA) and escalation: activity diagram (lanes = actors)
flowchart TD
  subgraph ST["Student (resident)"]
    s(("start")) --> a1["Report a problem: category, location,<br/>urgency, photos, furniture item"]
    a5{"Fixed?"}
    a6["Confirm the fix"]
    a7["Reopen: not fixed yet"]
  end
  subgraph SY["System"]
    y1["Request: Submitted"]
    y2["Routing rule picks Staff;<br/>SLA deadline = urgent or normal timer"]
    y3["Request: Assigned; notify Staff and student"]
    y4{"Every 15 min: past the deadline<br/>or unassigned too long?"}
    y5["Open an escalation for Managers"]
    y6["Request: Closed; furniture item history updated"]
    e((("end")))
  end
  subgraph SF["Staff"]
    f1["Start the work (In progress)"]
    f2["Mark it resolved"]
  end
  subgraph MG["Manager"]
    g1["Handle the escalation:<br/>reassign or note the action"]
  end
  a1 --> y1 --> y2 --> y3 --> f1 --> f2 --> a5
  y3 --> y4
  y4 -- "yes" --> y5 --> g1 --> f1
  y4 -- "no" --> f1
  a5 -- "yes" --> a6 --> y6 --> e
  a5 -- "no" --> a7 --> y3
