# Copy to infra/.env (git-ignored) and adjust. Never commit real secrets.
DB_USER=campusstay
DB_PASSWORD=campusstay
WEB_BASE_URL=http://localhost:5173
# Google Identity Services OAuth client id (Web application type). Blank = Google sign-in off.
GOOGLE_CLIENT_ID=
# Secret of the same client, used only to exchange the web popup's authorization code (ADR-14).
# Blank = the web's "Sign in with Google" is off; Android ID tokens still work.
GOOGLE_CLIENT_SECRET=
# The bank account students transfer to, shown with a VietQR image on the payment page (ADR-22). Students press
# "I have transferred" and a Manager confirms. Blank account = no QR image; payments still work.
PAYMENT_BANK_NAME=MB Bank
# Bank short name of the VietQR image service (qr.sepay.vn), e.g. MBBank, Vietcombank.
PAYMENT_BANK_CODE=MBBank
PAYMENT_ACCOUNT_NUMBER=0000000000
PAYMENT_ACCOUNT_NAME=CAMPUSSTAY FPT DEMO
# Folder for uploaded files (payment receipts, maintenance photos). Back it up with the database.
# FILES_DIR=data/files
# Secret that signs the short-lived links to photos and receipts (any long random text).
# Blank = a new random secret at each start (links handed out before a restart stop working).
FILES_LINK_SECRET=
# Path to the Firebase service account key (JSON) used for Android push. Blank = push off.
FIREBASE_CREDENTIALS_FILE=
