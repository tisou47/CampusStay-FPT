# Copy to infra/.env (git-ignored) and adjust. Never commit real secrets.
DB_USER=campusstay
DB_PASSWORD=campusstay
WEB_BASE_URL=http://localhost:5173
# Google Identity Services OAuth client id (Web application type). Blank = Google sign-in off.
GOOGLE_CLIENT_ID=
# Secret of the same client, used only to exchange the web popup's authorization code (ADR-14).
# Blank = the web's "Sign in with Google" is off; Android ID tokens still work.
GOOGLE_CLIENT_SECRET=
# Receiving bank account shown on the VietQR payment page (ADR-08).
PAYMENT_BANK_NAME=MB Bank
# Bank short name used by SePay's VietQR image service (qr.sepay.vn), e.g. MBBank, Vietcombank.
PAYMENT_BANK_CODE=MBBank
PAYMENT_ACCOUNT_NUMBER=0000000000
PAYMENT_ACCOUNT_NAME=CAMPUSSTAY FPT DEMO
# API key of the SePay webhook (SePay sends "Authorization: Apikey <key>"). Blank = webhook off.
SEPAY_WEBHOOK_API_KEY=
# Later slices:
# FIREBASE_CREDENTIALS_FILE=
