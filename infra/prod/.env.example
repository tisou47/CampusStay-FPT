# Production settings for the Ubuntu VPS (ADR-16). Copy to /opt/campusstay/.env on the VPS and
# run `chmod 600 .env`. Never commit the real file. Unset lines keep the defaults of application.yml.

# --- Addresses ---
# Hostname of the API. Its DNS A record points at the VPS's public IPv4 (README.md §1.6); Caddy gets the certificate.
API_DOMAIN=api.campusstay.id.vn
# Production URL of the web app on Vercel. Password-reset and invitation emails link here.
WEB_BASE_URL=https://campusstay-fpt-ten.vercel.app
# Browser origins allowed to call the API, comma-separated. "*" is a wildcard: Vercel preview deployments
# are campusstay-<hash>-tisou.vercel.app and campusstay-fpt-git-<branch>-tisou.vercel.app.
CORS_ALLOWED_ORIGINS=https://campusstay-fpt-ten.vercel.app,https://campusstay-*-tisou.vercel.app

# --- Database ---
# Default: Postgres runs in the stack (service db, profile local-db). For a managed database such as Azure Database
# for PostgreSQL (README.md appendix A), delete COMPOSE_PROFILES, set DB_URL and use that server's admin user.
COMPOSE_PROFILES=local-db
# DB_URL=jdbc:postgresql://<server>.postgres.database.azure.com:5432/campusstay?sslmode=require
DB_USER=campusstay
# Generated on the VPS: `openssl rand -hex 32` (hex, so no "$" for Compose to expand). Managed database: its password.
DB_PASSWORD=

# --- Secrets generated on the VPS: `openssl rand -hex 32` ---
# Signs the short-lived links to receipts and photos. Blank = new secret at each restart (old links break).
FILES_LINK_SECRET=
# Encrypts the Rooms' door codes (AES-256): `openssl rand -base64 32`, never printed. Keep it: another key makes the
# stored codes unreadable (Staff then set new ones). Blank = the door-code screens answer 503, everything else works.
DOOR_CODE_KEY=

# --- Base data (8 Blocks, staff accounts, 6,200 fictional students; no Terms or history; mock SIS, ADR-02) ---
# README.md §1.10. Keep the first line for the life of the database (the seed is idempotent). If you ever remove
# it after the seed was loaded, set the second line, or Flyway refuses to start.
# SPRING_FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed
# SPRING_FLYWAY_IGNOREMIGRATIONPATTERNS=repeatable:missing

# --- Google sign-in (the same OAuth client as the web's VITE_GOOGLE_CLIENT_ID) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Email: Gmail SMTP with an App Password (ADR-09). Without SPRING_MAIL_HOST no email is sent (only its subject is logged). ---
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=<account>@gmail.com
# SPRING_MAIL_PASSWORD=<16-character App Password>
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# MAIL_FROM=CampusStay FPT <account@gmail.com>
# Demo server: emails to fictional accounts (the base data, the demo scenarios) go to this one mailbox, the
# recipient in front of the subject; real accounts (Google sign-up, imported student list, invited staff) still
# receive their own email (spec O-3). Blank = each email goes to its recipient.
# MAIL_REDIRECT_TO=<team mailbox>@gmail.com

# Demo server only: the Admin may replace the business data by a demo stage (Admin › System › Demo data,
# spec §15). Needs the base data (db/seed). A reset replaces every business record, for every user: never on a
# server with real residents.
# DEMO_TOOLS=true

# --- Payments: the account students transfer to (ADR-22) ---
# Students transfer, press "I have transferred", and a Manager confirms each claim. With an account set, the payment
# page also shows its VietQR image (a public image service); blank = no QR image, payments still work.
# PAYMENT_BANK_NAME=MB Bank
# Bank short name of the VietQR image service, e.g. MBBank, Vietcombank, TPBank.
# PAYMENT_BANK_CODE=MBBank
# PAYMENT_ACCOUNT_NUMBER=
# PAYMENT_ACCOUNT_NAME=

# --- Android push (Firebase Cloud Messaging) ---
# Service account key copied to /opt/campusstay/secrets/firebase.json on the VPS (mounted read-only at /app/secrets).
# FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase.json

# --- Image. The deploy workflow sets both; set API_TAG to a commit SHA here to stay on an older build. ---
# API_IMAGE=ghcr.io/tisou47/campusstay-backend
# API_TAG=latest
# Memory of the API container: 2g on a 4 GB VPS (default), 1g on a 2 GB one (README.md §1.1), 700m on a 1 GB Azure VM.
# API_MEMORY=2g
