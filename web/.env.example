# Copy to .env.local (or .env.development.local) and adjust.

# Base URL of the CampusStay API as seen by the browser.
# Keep "/api" to call the API through the Vite dev proxy (development) or a reverse proxy (production).
VITE_API_BASE_URL=/api

# Development only: where the Vite dev server forwards /api requests.
VITE_API_PROXY_TARGET=http://localhost:8080

# Google OAuth client ID (Web application) for "Sign in with Google". Only @fpt.edu.vn accounts are offered,
# and the backend must still check the domain. Use the same client as the backend's GOOGLE_CLIENT_ID
# (the backend also needs GOOGLE_CLIENT_SECRET). Leave empty to show a "not set up" message on the button.
VITE_GOOGLE_CLIENT_ID=

# Development only: open every portal without signing in (to review screens before the backend is ready).
# Has no effect in production builds.
VITE_SKIP_AUTH=false

# Show the "Simulate bank transfer" button on Invoice Payment in a production build (always shown in development).
# Only works when the API runs the dev profile; never enable it for a real deployment.
VITE_PAYMENT_SIMULATOR=false
