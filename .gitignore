# Each app keeps its own ignore file too: backend/.gitignore, web/.gitignore.

# OS and editors
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/*
!.vscode/extensions.json

# Secrets and machine-local settings
.env
.env.*
!.env.example
*.local
.claude/settings.local.json
.vercel/

# Logs
*.log

# School report templates (kept locally, not versioned)
/templates/

# Local settings
.claude/
.postman/
# SEP490 documents: Office lock/temp files never go to git (docs/ is mirrored from Google Drive)
/docs/**/~$*
/docs/**/.~lock*
/docs/**/*.tmp
/docs/**/desktop.ini
# Build artefacts
/build/
# Reference copies from the school, kept on the team machines only
/docs/SEP490_Report/SEP490 StudentGuide_Fall 2023.docx
